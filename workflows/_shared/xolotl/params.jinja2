# Material choice: Xolotl has no diamond/CVD material -- it was built for
# fusion plasma-surface interactions (PSI) and nuclear fuel. W100
# (tungsten, a real PSI material) is used here rather than Fuel, since W100
# genuinely models an incoming *surface* flux (matching what
# hdf5_mapper.py computes from WarpX's substrate bombardment), whereas
# Fuel's "flux" is actually reinterpreted internally as a bulk fission
# rate -- a much worse semantic fit despite being the simpler tutorial
# example. Xolotl's flux units are #/nm^2/s (see ConfOptions.cpp), not SI
# #/m^2/s -- ion_flux_per_nm2_per_s below is already converted.
# -ts_max_steps is hardcoded small (real solve rate is ~1-3 steps/s here,
# and dt is pinned at -ts_adapt_dt_max so it never gets close to
# -ts_max_time within a practical step budget) -- this is a coarse
# smoke-test bound, not a real production run length. Increasing it (and
# -ts_adapt_dt_max) to actually reach runtime_s is a follow-up.
petscArgs=-ts_adapt_clip 0.1,1.1 -ts_max_steps 500 -ts_max_time {{ runtime_s }} -ts_dt 1.0e-12 -ts_adapt_dt_max 1.0e-4 -ts_exact_final_time stepover -ts_monitor -pc_type fieldsplit -fieldsplit_0_pc_type sor -fieldsplit_1_pc_type redundant -ts_max_snes_failures -1 -pc_fieldsplit_detect_coupling -helium_retention
vizHandler=dummy
perfHandler=dummy
material=W100
dimensions={{ params.xolotl.dimensions }}
gridType=nonuniform
gridParam=10
process=reaction diff
flux={{ ion_flux_per_nm2_per_s }}
tempParam={{ substrate_temperature_k }}
