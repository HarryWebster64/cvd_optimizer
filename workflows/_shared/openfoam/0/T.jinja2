FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform {{ "%.4f"|format(inlet_temperature_k) }};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform {{ "%.4f"|format(inlet_temperature_k) }};
    }
    substrate
    {
        type            fixedValue;
        value           uniform {{ "%.4f"|format(substrate_temperature_k) }};
    }
    chamberWall
    {
        type            zeroGradient;
    }
    wedge1
    {
        type            wedge;
    }
    wedge2
    {
        type            wedge;
    }
}
