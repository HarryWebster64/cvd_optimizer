FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     reactingFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         {{ end_time }};

deltaT          {{ initial_delta_t }};

writeControl    adjustableRunTime;
writeInterval   {{ write_interval }};

purgeWrite      0;

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       {{ max_delta_t }};
